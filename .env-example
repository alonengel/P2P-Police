# Copy to .env and fill real values. NEVER commit .env (see .gitignore).
# All values here are dummies.

# --- LLM providers (trash-talk text only; moves are always pure Python) ---
ANTHROPIC_API_KEY=sk-ant-dummy
OPENROUTER_API_KEY=sk-or-dummy
OLLAMA_BASE_URL=http://localhost:11434

# --- Gmail OAuth (Appendix A): file paths, files themselves are gitignored ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Tunneling (Cloudflare named tunnel credentials stay outside the repo) ---
TUNNEL_HOSTNAME=mcp.example.com
